@model IEnumerable<WebProLimp.Models.Venta>

@{
    ViewData["Title"] = "Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Ventas</h1>

<p>
    <a asp-action="Create"><i class="fas fa-plus-circle" aria-hidden="true"></i> Crear nueva venta</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>ID Venta</th>
            <th>Cliente</th>
            <th>Empleado</th>
            <th>Fecha</th>
            <th>Total</th>
            <th>Detalles</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IdclienteNavigation.RazonSocial)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IdempleadoNavigation.Nombres)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Fecha)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Total)
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" title="Ver Detalles"><i class="fas fa-eye" aria-hidden="true"></i> Ver Productos</a>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" title="Editar"><i class="fas fa-pencil-alt" aria-hidden="true"></i></a> |
                    <a asp-action="Details" asp-route-id="@item.Id" title="Detalle"><i class="fas fa-eye" aria-hidden="true"></i></a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" title="Eliminar"><i class="fas fa-trash" aria-hidden="true"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>