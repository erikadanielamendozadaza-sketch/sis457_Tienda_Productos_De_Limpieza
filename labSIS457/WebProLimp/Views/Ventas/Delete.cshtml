@model WebProLimp.Models.Venta

@{
    ViewData["Title"] = "Eliminar Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Eliminar Venta</h1>

<h3>¿Estás seguro que quieres borrar la venta?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">ID Venta</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2">Cliente</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdclienteNavigation.RazonSocial)
        </dd>
        <dt class="col-sm-2">Empleado</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdempleadoNavigation.Nombres)
        </dd>
        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Fecha)
        </dd>
        <dt class="col-sm-2">Total</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Total)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="fa fa-trash" aria-hidden="true"></i> Eliminar
        </button> |
        <a asp-action="Index"><i class="fa fa-arrow-left" aria-hidden="true"></i> Volver a la lista</a>
    </form>
</div>