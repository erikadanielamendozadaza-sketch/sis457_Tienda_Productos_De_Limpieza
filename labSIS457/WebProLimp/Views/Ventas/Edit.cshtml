@model WebProLimp.Models.Venta

@{
    ViewData["Title"] = "Editar Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Editar Venta</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label class="control-label">Cliente</label>
                <select asp-for="Idcliente" class="form-select" asp-items="ViewBag.Idcliente">
                    <option disabled selected value="">Seleccione un cliente</option>
                </select>
                <span asp-validation-for="Idcliente" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Empleado</label>
                <select asp-for="Idempleado" class="form-select" asp-items="ViewBag.Idempleado">
                    <option disabled selected value="">Seleccione un empleado</option>
                </select>
                <span asp-validation-for="Idempleado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Fecha</label>
                <input asp-for="Fecha" type="date" class="form-control" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Total</label>
                <input asp-for="Total" type="number" class="form-control" />
                <span asp-validation-for="Total" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="UsuarioRegistro" />
            <input type="hidden" asp-for="FechaRegistro" />
            <input type="hidden" asp-for="Estado" />
            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-floppy-disk" aria-hidden="true"></i> Guardar
                </button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index"><i class="fa fa-arrow-left" aria-hidden="true"></i> Volver a la Lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
