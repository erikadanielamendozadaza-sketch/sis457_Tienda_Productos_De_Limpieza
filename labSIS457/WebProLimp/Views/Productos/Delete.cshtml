@model WebProLimp.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Eliminar Producto</h1>

<h3>¿Estás seguro que quiere borrar el producto?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Código</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Codigo)
        </dd>
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class="col-sm-2">Marca</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdmarcaNavigation.Id)
        </dd>
        <dt class="col-sm-2">Unidad de Medida</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdunidadMedidaNavigation.Id)
        </dd>
        <dt class="col-sm-2">Categoría</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdcategoriaNavigation.Id)
        </dd>
        <dt class="col-sm-2">Proveedor </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdproveedorNavigation.Id)
        </dd>
        <dt class="col-sm-2">Precio Unitario</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PrecioUnitario)
        </dd>
        <dt class="col-sm-2">Stock</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Stock)
        </dd>
        <dt class="col-sm-2">Fecha de Vencimiento </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaVencimiento)
        </dd>
        <dt class="col-sm-2">Precio de Compra</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PrecioCompra)
        </dd>
        <dt class="col-sm-2">Cantidad Mínima Stock</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CantidadMinimaStock)
        </dd>
        <dt class="col-sm-2">Usuario Registro</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UsuarioRegistro)
        </dd>
        <dt class="col-sm-2">Fecha Registro</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaRegistro)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="fa fa-trash" aria-hidden="true"></i> Eliminar
        </button> |
        <a asp-action="Index"><i class="fa fa-arrow-left" aria-hidden="true"></i> Volver a la lista</a>
    </form>
</div>
