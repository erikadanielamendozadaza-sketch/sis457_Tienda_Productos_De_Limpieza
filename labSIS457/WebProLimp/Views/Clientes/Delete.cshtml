@model WebProLimp.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Eliminar Cliente</h1>

<h3>¿Estas seguro de eliminar el cliente?</h3>
<div>
    <dl class="row">
        <dt class = "col-sm-2">Razon Social</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RazonSocial)
            </dd>
        <dt class="col-sm-2">Cedula Identidad</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CedulaIdentidad)
        </dd>
        <dt class="col-sm-2">Usuario Registro</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UsuarioRegistro)
        </dd>
        <dt class="col-sm-2">Fecha Registro</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaRegistro)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
                <i class="fa fa-trash" aria-hidden="true">Eliminar cliente</i>
        </button>
        <br>
        <a asp-action="Index"><i class="fa fa-arrow-left" aria-hidden="true"></i> Volver a la lista</a>
    </form>
</div>
